{
  "name": "md-sync",
  "version": "0.1.0",
  "description": "Git-backed, two-way Markdown folder sync daemon",
  "type": "module",
  "bin": {
    "md-sync": "src/cli.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile src/cli.ts --outfile dist/md-sync",
    "test:integration": "bun test ./test/integration",
    "test:acceptance": "bun test ./test/acceptance",
    "test:live": "bun run ./test/live/github.ts",
    "test:all": "bun test ./test/unit ./test/integration ./test/acceptance"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^5"
  }
}
